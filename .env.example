# Copy to .env for local (non-docker) development. Every setting is optional unless noted.

# --- General ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
# Token for /v1/admin/* (creating projects). Leave empty to disable the admin API. REQUIRED to bootstrap.
ADMIN_TOKEN=change-me

# --- Database / queue ------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://mediapipe:mediapipe@localhost:5432/mediapipe
REDIS_URL=redis://localhost:6379/0
# Defaults to REDIS_URL when empty
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# Run tasks inline instead of queueing them (tests / quick demos)
CELERY_TASK_ALWAYS_EAGER=false

# --- Object storage (MinIO locally, AWS S3 in production) ------------------
# Leave S3_ENDPOINT_URL empty for AWS S3.
S3_ENDPOINT_URL=http://localhost:9000
# Address clients use to reach storage (presigned URLs are signed for this host). Defaults to S3_ENDPOINT_URL.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=mediapipe
# "path" for MinIO, "virtual" or "auto" for AWS
S3_ADDRESSING_STYLE=path
# Create the bucket on API startup if missing (handy for MinIO)
S3_AUTO_CREATE_BUCKET=true

# --- Uploads ---------------------------------------------------------------
UPLOAD_URL_EXPIRES_SECONDS=900
DOWNLOAD_URL_EXPIRES_SECONDS=3600
# Files larger than this use multipart upload (default 100 MB)
MULTIPART_THRESHOLD_BYTES=104857600
MULTIPART_PART_SIZE_BYTES=67108864
# Per-type size limits (defaults: 25 MB / 50 MB / 2 GB)
MAX_IMAGE_BYTES=26214400
MAX_DOCUMENT_BYTES=52428800
MAX_VIDEO_BYTES=2147483648
# Uploads never completed within this many hours are deleted by the beat task
UPLOAD_CLEANUP_AFTER_HOURS=24

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60

# --- Jobs ------------------------------------------------------------------
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=5
JOB_RETRY_MAX_SECONDS=300
VIDEO_TIMEOUT_SECONDS=21600
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Webhooks --------------------------------------------------------------
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_RETRY_BASE_SECONDS=10
# Allow endpoints on private/loopback addresses (SSRF protection is ON by default)
WEBHOOK_ALLOW_PRIVATE_URLS=false
# Receivers should reject signatures older than this
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300

# --- Server-Sent Events ----------------------------------------------------
SSE_POLL_INTERVAL_SECONDS=1
SSE_MAX_SECONDS=3600
